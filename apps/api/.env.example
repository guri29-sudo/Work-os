# API Service Environment Configuration
PORT=3001
API_HOST=0.0.0.0
NODE_ENV=production

# Database (PostgreSQL with RLS)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
MIGRATION_DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Authentication & JWKS
JWT_ISSUER=https://api.yourdomain.com
JWKS_URL=https://api.yourdomain.com/.well-known/jwks.json
JWT_AUDIENCE=communication-system

# CORS (Frontend origin)
CORS_ORIGIN=https://app.yourdomain.com

# Webhooks & Rate Limiting
WEBHOOK_SIGNING_SECRET=change_this_to_a_random_32_char_secret_in_prod
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000

# Object Storage (S3 / Cloudflare R2 / MinIO)
STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_BUCKET=cs-attachments
STORAGE_REGION=auto
